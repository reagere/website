<style>
  .seal {
    --arm-pose: 0deg;
    --look: 0deg;
    --lean: 0deg;
    --ax: 73.014%;
    --ay: 36.029%;
    --anx: -73.014%;
    --any: -36.029%;
    --hx: 43.294%;
    --hy: 41.211%;
    --hnx: -43.294%;
    --hny: -41.211%;
    --lx: 41.313%;
    --ly: 48.222%;
    --lnx: -41.313%;
    --lny: -48.222%;
  }

  .brush {
    stroke: currentColor;
    stroke-width: 0.982;
    stroke-linejoin: miter;
    stroke-miterlimit: 4;
    stroke-linecap: butt;
  }

  /* Percentages of the viewBox: the joint stays put at any rendered size.
     The bar and the raised arm are one stroke, so the turn stays small. */
  .joint,
  .life {
    transform-box: view-box;
    transform-origin: 0 0;
  }
  .joint {
    transition: transform 0.7s cubic-bezier(0.22, 0.7, 0.3, 1);
  }
  .joint-arm {
    transform: translate(var(--ax), var(--ay)) rotate(var(--arm-pose)) translate(var(--anx), var(--any));
  }
  .joint-head {
    transform: translate(var(--hx), var(--hy)) rotate(var(--look)) translate(var(--hnx), var(--hny));
  }
  .joint-legs {
    transform: translate(var(--lx), var(--ly)) rotate(var(--lean)) translate(var(--lnx), var(--lny));
  }

  .life-arm { animation: seal-arm 4.6s ease-in-out infinite; }
  .life-head { animation: seal-head 4.6s ease-in-out infinite; }
  .life-legs { animation: seal-legs 4.6s ease-in-out infinite; }

  @keyframes seal-arm {
    0%, 100% { transform: translate(var(--ax), var(--ay)) rotate(-1.2deg) translate(var(--anx), var(--any)); }
    50% { transform: translate(var(--ax), var(--ay)) rotate(1.2deg) translate(var(--anx), var(--any)); }
  }
  @keyframes seal-head {
    0%, 100% { transform: translate(var(--hx), var(--hy)) rotate(-1.4deg) translate(var(--hnx), var(--hny)) translateY(0.5%); }
    50% { transform: translate(var(--hx), var(--hy)) rotate(1.4deg) translate(var(--hnx), var(--hny)) translateY(-0.5%); }
  }
  @keyframes seal-legs {
    0%, 100% { transform: translate(var(--lx), var(--ly)) rotate(-0.8deg) translate(var(--lnx), var(--lny)); }
    50% { transform: translate(var(--lx), var(--ly)) rotate(0.8deg) translate(var(--lnx), var(--lny)); }
  }

  :global(html[data-lens="mission"]) .seal {
    --arm-pose: -2.2deg;
    --look: -1.5deg;
    --lean: -0.7deg;
  }
  :global(html[data-lens="produit"]) .seal {
    --arm-pose: 1.8deg;
    --look: 1deg;
    --lean: 0.5deg;
  }
  :global(html[data-lens="editions"]) .seal {
    --arm-pose: 1.2deg;
    --look: 0.4deg;
    --lean: -0.35deg;
  }
  :global(html[data-lens="portfolio"]) .seal {
    --arm-pose: -1.6deg;
    --look: -0.8deg;
    --lean: 0.6deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .life { animation: none; }
    .joint { transition: none; }
  }
  @media print {
    .life { animation: none; }
    .joint { transition: none; }
  }
</style>
